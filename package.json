{
  "name": "wyatth99.github.io",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "run-p start:*",
    "start:jekyll": "bundle exec jekyll serve --host 0.0.0.0",
    "start:postcss": "postcss _site/assets/styles/*.css --dir _site/assets --watch",
    "build": "run-s clean build:jekyll build:postcss",
    "build:jekyll": "JEKYLL_ENV=production bundle exec jekyll build",
    "build:postcss": "cross-env NODE_ENV=production postcss _site/assets/styles/*.css --dir _site/assets",
    "clean": "rimraf _site"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WyattH99/WyattH99.github.io"
  },
  "keywords": [
    "jekyll",
    "github-pages",
    "tailwind"
  ],
  "author": "Wyatt Hansen",
  "license": "ISC",
  "homepage": "https://github.com/WyattH99/WyattH99.github.io",
  "devDependencies": {

    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.5"
  }
}
