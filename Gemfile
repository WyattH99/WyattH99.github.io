# This gem is recommended for building Jekyll sites on GitHub Pages.
# It includes Jekyll and other dependencies that GitHub Pages uses.
gem "github-pages", group: :jekyll_plugins
gem "webrick"


group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
end

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
# and Gemfile.lock to record the zoneinfo file layout being used.
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]